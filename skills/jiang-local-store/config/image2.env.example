# Copy to ~/.config/jiang-local-store/image2.env and chmod 600.
# Never commit or paste the real API key into chat.

IMAGE2_PROVIDER_NAME="Your relay name"
IMAGE2_API_KEY="replace-locally"
IMAGE2_BASE_URL="https://relay.example.com/v1"
IMAGE2_MODEL="gpt-image-2"

# Enable only when the relay documentation requires different values.
# IMAGE2_AUTH_HEADER="Authorization"
# IMAGE2_AUTH_PREFIX="Bearer "  # Use "none" when the relay requires no prefix.
# IMAGE2_EXTRA_HEADERS_JSON='{"X-Client":"jiang-local-store"}'
# IMAGE2_GENERATIONS_PATH="/images/generations"
# IMAGE2_EDITS_PATH="/images/edits"
# IMAGE2_MODELS_PATH="/models"
# IMAGE2_IMAGE_FIELD="image[]"
# IMAGE2_MASK_FIELD="mask"
